{
  "name": "@schalkneethling/css-console",
  "version": "0.0.0",
  "description": "Development-only CSS value probes: turn source-local CSS comments into live, element-specific reports of authored and browser-resolved values.",
  "keywords": [
    "css",
    "cssom",
    "debugging",
    "devtools"
  ],
  "homepage": "https://github.com/schalkneethling/css-console#readme",
  "bugs": {
    "url": "https://github.com/schalkneethling/css-console/issues"
  },
  "license": "MIT",
  "author": "Schalk Neethling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schalkneethling/css-console.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --build",
    "lint:structural": "ast-grep scan",
    "stylelint": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix --allow-empty-input",
    "e2e": "playwright test --pass-with-no-tests",
    "inspect:annotations": "node scripts/inspect-annotations.ts",
    "inspect:probes": "node scripts/inspect-probes.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.0",
    "@playwright/test": "^1.62.0",
    "@schalkneethling/stylelint-plugin-css-property-type-validator": "0.1.0-beta.1",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-use-baseline": "^1.4.4",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
