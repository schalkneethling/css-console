{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "modern",
  "packageManager": "pnpm",
  "integrations": [
    "editorconfig",
    "oxlint",
    "oxlint-eslint",
    "oxlint-unicorn",
    "oxlint-oxc",
    "oxlint-import",
    "oxlint-node",
    "oxlint-promise",
    "oxlint-vitest",
    "oxlint-jsdoc",
    "oxfmt",
    "stylelint",
    "stylelint-standard",
    "stylelint-order",
    "stylelint-baseline",
    "css-property-type-validator"
  ],
  "scripts": {
    "lint": true,
    "lint:fix": true,
    "format": true,
    "format:check": true,
    "typecheck": true,
    "quality": true
  },
  "ai": [
    {
      "type": "skill",
      "src": "skills/more-secure-dependabot-config"
    },
    {
      "type": "skill",
      "src": "skills/npm-publishing-best-practices"
    },
    {
      "type": "skill",
      "src": "skills/npm-trusted-publishing-github-workflow"
    }
  ]
}
