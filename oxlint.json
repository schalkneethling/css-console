{
  "plugins": ["eslint", "unicorn", "oxc", "import", "node", "promise", "vitest", "jsdoc"],
  "rules": {},
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "*/**", "!./*", "!./**", "!../*", "!../**"],
                "message": "Nothing under src/ imports a package or a node: builtin. Add an allowlist negation here only for a browser-safe dependency named in a decision record."
              }
            ]
          }
        ]
      }
    }
  ]
}
